# LLM_MODE: mock | gemini | groq | openrouter
# - mock: Không gọi mạng (mặc định offline)
# - gemini: Dùng Gemini REST API qua Google AI Studio
# - groq: Siêu nhanh, dùng Llama-3.3-70b qua Groq API
# - openrouter: Dùng OpenRouter API (đa dạng model)
LLM_MODE=mock

# --- Cấu hình Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Cấu hình Groq (Khuyên dùng: siêu nhanh ~300 tokens/s) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cấu hình OpenRouter (Khuyên dùng: gpt-4o-mini siêu nhanh & tiếng Việt chuẩn) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Path to the mock-data directory, resolved relative to the backend/ folder
DATA_DIR=../mock-data

# Confidence thresholds that pick the item.path (happy / low_confidence /
# no_grounding) -- see docs/backend.md and planning/02_*/plan.md §2.
HIGH_CONF_MIN=0.75
LOW_CONF_MIN=0.4
