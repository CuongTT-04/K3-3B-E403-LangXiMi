# mock | real | gemini | chain | groq -- mock does not call any network,
# real is not implemented yet. gemini/chain both mean "the full provider
# chain": Gemini (primary) -> Groq (fallback) -> Mock (last resort), using
# whichever of GEMINI_API_KEY/GROQ_API_KEY are set (missing key -> that
# provider is skipped in the chain). groq means Groq -> Mock only (skips
# Gemini even if GEMINI_API_KEY is set). See below for details.
LLM_MODE=mock

# API key for LLM_MODE=real (unused while LLM_MODE=mock/gemini/chain/groq)
LLM_API_KEY=

# API key for Gemini (used by LLM_MODE=gemini/chain). Missing key -> Gemini
# is skipped in the chain (falls straight to Groq, then Mock).
GEMINI_API_KEY=

# Legacy single-model override for Gemini: if set, this model is moved to
# the FRONT of the GEMINI_MODELS rotation (see below), deduped.
GEMINI_MODEL=

# Comma-separated list of Gemini models GeminiLLM rotates through. Google's
# free tier caps each model at 20 requests/DAY; on 429/404/503/malformed-
# JSON it switches to the next model in the list immediately (a timeout
# retries the SAME model once first). Once every model here has failed,
# GeminiLLM used standalone falls back to MockLLM itself; used inside the
# chain (LLM_MODE=gemini/chain) it instead lets Groq have a turn. Default
# when unset:
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.8-flash,gemini-3.1-flash-lite

# API key for Groq (used by LLM_MODE=groq, and as the 2nd tier of
# LLM_MODE=gemini/chain after Gemini's quota is exhausted). Missing key ->
# Groq is skipped (chain falls straight to Mock; LLM_MODE=groq alone falls
# straight to Mock).
GROQ_API_KEY=

# Legacy single-model override for Groq: if set, this model is moved to the
# FRONT of the GROQ_MODELS rotation (see below), deduped.
GROQ_MODEL=

# Comma-separated list of Groq (OpenAI-compatible chat completions API)
# models GroqLLM rotates through. Measured limits: 1000 requests/DAY (not
# per-model, unlike Gemini) and 8000 tokens/MINUTE. On 429/404/5xx/timeout/
# malformed-JSON it switches to the next model immediately (no same-model
# retry, not even for a timeout). llama-3.3-70b-versatile is NOT available
# on this account. Default when unset:
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# on/off switch for the on-disk LLM response cache (backend/.runtime/llm-cache.json).
# "off" makes every real call (Gemini or Groq) hit the network; anything
# else (or unset) caches successful responses keyed by prompt version +
# question id + chosen answer + retrieved chunk ids (no provider name in
# the key, so a Groq-produced answer also satisfies a later Gemini-first
# lookup for the same input), so re-running the eval or a demo never
# re-spends quota on an input already answered for real.
LLM_CACHE=

# Overrides the on-disk LLM cache file path (tests point this at a tmp_path
# so they never touch the real cache file). Use a DIFFERENT path per
# provider you eval separately, e.g. backend/.runtime/llm-cache-groq.json
# for `LLM_MODE=groq python backend/eval/run_eval.py --llm-stats --sleep 1`,
# so a real Groq eval run never overwrites the Gemini cache (or vice versa).
LLM_CACHE_PATH=

# Path to the mock-data directory, resolved relative to the backend/ folder
DATA_DIR=../mock-data

# Confidence thresholds that pick the item.path (happy / low_confidence /
# no_grounding) -- see docs/backend.md and planning/02_*/plan.md §2.
HIGH_CONF_MIN=0.75
LOW_CONF_MIN=0.4
