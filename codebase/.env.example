# mock | real | gemini -- mock does not call any network, real is not
# implemented yet, gemini calls the real Gemini REST API (see below)
LLM_MODE=mock

# API key for LLM_MODE=real (unused while LLM_MODE=mock/gemini)
LLM_API_KEY=

# API key for LLM_MODE=gemini. Missing key -> logs a warning and falls
# back to MockLLM automatically, the demo never breaks for lack of a key.
GEMINI_API_KEY=

# Gemini model id used when LLM_MODE=gemini
GEMINI_MODEL=gemini-2.5-flash

# Path to the mock-data directory, resolved relative to the backend/ folder
DATA_DIR=../mock-data

# Confidence thresholds that pick the item.path (happy / low_confidence /
# no_grounding) -- see docs/backend.md and planning/02_*/plan.md §2.
HIGH_CONF_MIN=0.75
LOW_CONF_MIN=0.4
