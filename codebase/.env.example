# mock | real | gemini -- mock does not call any network, real is not
# implemented yet, gemini calls the real Gemini REST API (see below)
LLM_MODE=mock

# API key for LLM_MODE=real (unused while LLM_MODE=mock/gemini)
LLM_API_KEY=

# API key for LLM_MODE=gemini. Missing key -> logs a warning and falls
# back to MockLLM automatically, the demo never breaks for lack of a key.
GEMINI_API_KEY=

# Legacy single-model override for LLM_MODE=gemini: if set, this model is
# moved to the FRONT of the GEMINI_MODELS rotation (see below), deduped.
GEMINI_MODEL=

# Comma-separated list of Gemini models GeminiLLM rotates through when
# LLM_MODE=gemini. Google's free tier caps each model at 20 requests/DAY;
# on 429/404/503/malformed-JSON it switches to the next model in the list
# immediately (a timeout retries the SAME model once first). Falls back to
# MockLLM only once every model here has failed. Default when unset:
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.8-flash,gemini-3.1-flash-lite

# on/off switch for the on-disk LLM response cache (backend/.runtime/llm-cache.json).
# "off" makes every LLM_MODE=gemini call hit the network; anything else (or
# unset) caches successful Gemini responses keyed by prompt version +
# question id + chosen answer + retrieved chunk ids, so re-running the eval
# or a demo never re-spends quota on an input already answered for real.
LLM_CACHE=

# Overrides the on-disk LLM cache file path (tests point this at a tmp_path
# so they never touch the real cache file).
LLM_CACHE_PATH=

# Path to the mock-data directory, resolved relative to the backend/ folder
DATA_DIR=../mock-data

# Confidence thresholds that pick the item.path (happy / low_confidence /
# no_grounding) -- see docs/backend.md and planning/02_*/plan.md §2.
HIGH_CONF_MIN=0.75
LOW_CONF_MIN=0.4
